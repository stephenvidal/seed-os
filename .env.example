# Copy to .env and fill in. Never commit .env.
# Required to enable sign-in. Use a long random value.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Required for sessions to survive restarts. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SEED_SESSION_SECRET=
# Set true when served over HTTPS (behind a TLS-terminating proxy).
SEED_COOKIE_SECURE=false
SEED_HTTP_PORT=8080
