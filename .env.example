# Copy to .env and fill in. Never commit .env.
# The first admin, created on first start while no users exist. Use a long
# random value. Later changes: python -m seed_api.users set-password admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Set true when served over HTTPS (behind a TLS-terminating proxy).
SEED_COOKIE_SECURE=false
SEED_HTTP_PORT=8080
# Postgres password for the compose stack (required by compose.yaml).
SEED_POSTGRES_PASSWORD=
# Outside compose, point at Postgres directly. Unset disables sign-in and tasks.
# SEED_DATABASE_URL=postgresql://seed:password@localhost:5432/seed
# Model provider (Milestone 2). Unset disables Chat.
SEED_OLLAMA_API_KEY=
# SEED_OLLAMA_BASE_URL=https://ollama.com
# ADR-0007: deepseek-v4.1-flash; fallbacks glm-5.3-flash, gpt-oss:120b.
SEED_DEFAULT_MODEL=deepseek-v4.1-flash
